{
  "name": "edebo-website",
  "private": true,
  "type": "module",
  "description": "edebo.in static site. Web root is site/; blog posts live in content/blog/*.md and are built into site/blog/.",
  "scripts": {
    "build": "node scripts/blog/build.mjs",
    "blog:new": "node scripts/blog/new-post.mjs",
    "blog:check": "node scripts/blog/build.mjs --check",
    "serve": "python3 -m http.server 8080 --directory site",
    "dev": "node scripts/blog/build.mjs && python3 -m http.server 8080 --directory site"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
